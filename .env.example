# Copy to .env.local for local development. Set these privately in Hostinger.
APP_URL=https://your-domain.example
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Generate with npm run password:hash; never use your plaintext password here.
# In local .env.local escape each $ as \$ (Next.js expands dollar signs).
# In Hostinger's environment variable form paste the raw hash unchanged.
ADMIN_PASSWORD_HASH=
# At least 32 cryptographically random characters; never commit a live secret.
SESSION_SECRET=
